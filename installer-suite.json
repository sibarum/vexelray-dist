    { "config": "../text-editor-vexel-demo/installer.json", "page": "https://github.com/sibarum/vexelray-framework/blob/main/docs/apps/text-editor.md" },
    { "config": "../Pix/installer.json", "page": "https://github.com/sibarum/vexelray-framework/blob/main/docs/apps/pix.md" },
    { "config": "../mainframe/installer.json", "page": "https://github.com/sibarum/vexelray-framework/blob/main/docs/apps/mainframe.md" },
    { "config": "../calculator-vexel-demo/installer.json", "page": "https://github.com/sibarum/vexelray-framework/blob/main/docs/apps/calculator.md" },
    { "config": "../vexelray-sim-fluid/installer.json", "page": "https://github.com/sibarum/vexelray-sim-fluid" },
    { "config": "../vexelray-sim-rigid/installer.json", "page": "https://github.com/sibarum/vexelray-sim-rigid" }
